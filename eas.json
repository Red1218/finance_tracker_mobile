{
    "cli": {
        "version": ">= 18.0.0"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal"
        },
        "preview": {
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            }
        },
        "production": {
            "env": {
                "EXPO_PUBLIC_SUPABASE_URL": "@EXPO_PUBLIC_SUPABASE_URL",
                "EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "@EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY"
            }
        }
    },
    "submit": {
        "production": {}
    }
}